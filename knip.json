{
	"$schema": "./node_modules/knip/schema.json",
	"entry": ["main.ts"],
	"project": ["main.ts", "src/**/*.ts"],
	"ignore": ["tests/**", "vitest.config.mjs", "eslint.config.mjs", "stryker.config.mjs", "esbuild.config.mjs", "knip.json"],
	// showdown-highlight: dev-only, exists to compile the pinned upstream in
	// tests/parity (its src/format.ts imports it). Not part of the fork bundle.
	"ignoreDependencies": ["@vitest/coverage-v8", "showdown", "multimatch", "ts-md5", "showdown-highlight"],
	"treatConfigHintsAsErrors": false,
	"ignoreIssues": {
		// Public AnkiConnect builders: kept as API surface for present/future call sites.
		"src/anki.ts": ["exports", "types"],
		// Same-file-consumed helpers (Knip ignores tests/** by design, where they are also used).
		"src/scan-optimizations.ts": ["exports"],
		// Cross-module contracts consumed via setTransport mocks in tests/**.
		"src/anki-launch.ts": ["types"],
		"src/dry-run.ts": ["types"],
		// ScanControl/ScanProgress/ScanCancelledError: public UI contract —
		// consumed by main.ts (control/cancel) and tests/** (progress asserts).
		"src/files-manager.ts": ["types"],
		// Pure string helpers unit-tested directly in tests/unit/string-insert.test.ts.
		"src/file.ts": ["exports"]
	}
}

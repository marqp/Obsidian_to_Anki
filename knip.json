	"$schema": "./node_modules/knip/schema.json",
	"entry": ["main.ts"],
	"project": ["main.ts", "src/**/*.ts"],
	"ignore": ["tests/**", "wdio.conf.ts", "prepare-wdio.sh", "vitest.config.mjs", "eslint.config.mjs", "stryker.config.mjs", "rollup.config.js", "knip.json"],
	"ignoreBinaries": ["pip", "pytest"],
